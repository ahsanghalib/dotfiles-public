#!/usr/bin/env bash

set -euo pipefail
umask 077

temporary_output=''
temporary_directory=''

usage() {
    cat <<'USAGE'
Usage:
  crypt-file -e FILE...
  crypt-file -d FILE.gpg...
  crypt-file encrypt FILE...
  crypt-file decrypt FILE.gpg...
  crypt-file help

Encrypt uses GPG symmetric encryption with AES-256 and removes each plaintext
file only after its encrypted output has been written successfully. Decrypt
leaves the encrypted input file in place. Existing output files require
interactive confirmation before they are replaced; a negative answer skips
that file.
USAGE
}

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

path_exists() {
    [[ -e "$1" || -L "$1" ]]
}

confirm_overwrite() {
    local output="$1" answer

    if [[ ! -r /dev/tty || ! -w /dev/tty ]]; then
        printf 'Cannot ask for overwrite confirmation; refusing: %s\n' "$output" >&2
        return 1
    fi

    while true; do
        printf 'Overwrite %s? [y/N] ' "$output" > /dev/tty
        if ! IFS= read -r answer < /dev/tty; then
            printf '\n' > /dev/tty
            return 1
        fi
        printf '\n' > /dev/tty

        case "${answer,,}" in
        y | yes)
            return 0
            ;;
        n | no | '')
            return 1
            ;;
        *)
            printf 'Please answer yes or no.\n' > /dev/tty
            ;;
        esac
    done
}

cleanup() {
    if [[ -n "$temporary_output" ]] && path_exists "$temporary_output"; then
        rm -f -- "$temporary_output" || true
    fi
    if [[ -n "$temporary_directory" ]] && [[ -d "$temporary_directory" ]]; then
        rmdir -- "$temporary_directory" || true
    fi
}

trap cleanup EXIT

prepare_temporary_output() {
    local output="$1"
    local output_directory output_name

    output_directory="$(dirname -- "$output")"
    output_name="$(basename -- "$output")"
    temporary_directory="$(mktemp -d "$output_directory/.crypt-file.XXXXXX")"
    temporary_output="$temporary_directory/$output_name"
}

clear_temporary_output() {
    temporary_output=''
    if [[ -n "$temporary_directory" ]]; then
        rmdir -- "$temporary_directory" || true
        temporary_directory=''
    fi
}

validate_plaintext_input() {
    local input="$1"

    [[ ! -L "$input" ]] || die "refusing symlink input: $input"
    [[ -f "$input" ]] || die "not a regular file: $input"
}

encrypt_file() {
    local input="$1" output

    validate_plaintext_input "$input"
    output="${input}.gpg"

    if path_exists "$output"; then
        [[ ! -d "$output" ]] || die "output path is a directory: $output"
        if ! confirm_overwrite "$output"; then
            printf 'Skipped %s; existing output was not overwritten.\n' "$input"
            return 0
        fi
    fi

    prepare_temporary_output "$output"
    if ! gpg --no-symkey-cache --symmetric --cipher-algo AES256 --output "$temporary_output" -- "$input"; then
        die "encryption failed: $input"
    fi

    [[ -s "$temporary_output" ]] || die "GPG produced an empty output: $input"
    mv -- "$temporary_output" "$output"
    clear_temporary_output

    if ! rm -- "$input"; then
        die "encrypted output kept, but plaintext could not be removed: $input"
    fi

    printf 'Encrypted %s -> %s\n' "$input" "$output"
}

decrypt_file() {
    local input="$1" output

    validate_plaintext_input "$input"
    [[ "$input" == *.gpg ]] || die "encrypted input must end in .gpg: $input"
    output="${input%.gpg}"
    [[ -n "$output" && ! -d "$output" ]] || die "invalid decrypted output path: $output"
    if path_exists "$output" && ! confirm_overwrite "$output"; then
        printf 'Skipped %s; existing output was not overwritten.\n' "$input"
        return 0
    fi

    prepare_temporary_output "$output"
    if ! gpg --no-symkey-cache --decrypt --output "$temporary_output" -- "$input"; then
        die "decryption failed: $input"
    fi

    [[ -f "$temporary_output" ]] || die "GPG did not produce a decrypted file: $input"
    mv -- "$temporary_output" "$output"
    clear_temporary_output

    printf 'Decrypted %s -> %s (encrypted file kept)\n' "$input" "$output"
}

if (($# < 1)); then
    usage >&2
    exit 2
fi

case "$1" in
-e | -d | encrypt | decrypt)
    (( $# >= 2 )) || {
        usage >&2
        exit 2
    }
    require_command gpg
    case "$1" in
    -e | encrypt)
        operation=encrypt
        ;;
    -d | decrypt)
        operation=decrypt
        ;;
    esac
    shift
    for input in "$@"; do
        if [[ "$operation" == encrypt ]]; then
            encrypt_file "$input"
        else
            decrypt_file "$input"
        fi
    done
    ;;
help | -h | --help)
    usage
    ;;
*)
    printf 'Error: unknown command: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac

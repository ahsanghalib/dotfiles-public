{
  "base_keymap": "Zed",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "current_line_highlight": "all",
  "cursor_blink": false,
  "tab_size": 2,
  "hard_tabs": false,
  "preferred_line_length": 120,
  "soft_wrap": "bounded",
  "show_whitespaces": "all",
  "show_wrap_guides": true,
  "format_on_save": "on",
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "vertical_scroll_margin": 8,
  "horizontal_scroll_margin": 8,
  "minimap": {
    "show": "never"
  },
  "project_panel": {
    "dock": "left",
    "default_width": 240,
    "git_status": true,
    "auto_reveal_entries": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "history"
  },
  "terminal": {
    "font_size": 14.0,
    "copy_on_select": true,
    "cursor_shape": "block"
  },
  "cli_default_open_behavior": "existing_window",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "agent_ui_font_family": ".ZedMono",
  "ui_font_family": ".ZedSans",
  "buffer_line_height": "comfortable",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "diff_view_style": "split",
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6-luna"
      },
      "type": "registry"
    }
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "play_sound_when_agent_done": "always",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "group_by": "none",
    "tree_view": true,
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark Pro"
  },
  "git": {
    "worktree_directory": "../worktrees"
  }
}
